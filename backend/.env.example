# SOFAST POS Backend Environment Configuration Example
# Copy this file to .env and configure your actual environment values

# Server Port (Default: 5000)
PORT=5000

# Environment Mode (production, development, test)
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<atlas_cluster_url>/sofast_pos?retryWrites=true&w=majority

# Optional: MongoDB Direct Connection URI (if SRV DNS resolution is restricted)
# MONGODB_FALLBACK_URI=mongodb://<db_user>:<db_password>@shard-00-00.mongodb.net:27017,shard-00-01.mongodb.net:27017/sofast_pos?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# Authentication Secret (Generate a strong random string in production)
JWT_SECRET=your-secure-jwt-secret-here

# Allowed CORS Origins (comma-separated list, e.g. http://168.144.117.2,http://localhost:5173 or * to allow all)
CORS_ORIGIN=*